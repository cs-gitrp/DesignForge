# Lovable Cloud backend (managed; injected automatically in Lovable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional — enables real AI evaluation by calling the Gemini API directly
# (get a free key at aistudio.google.com/apikey). When set, it takes priority
# over LOVABLE_API_KEY, because LOVABLE_API_KEY is always present on Lovable
# Cloud — an explicitly set Gemini key is the way to force the direct tier.
GEMINI_API_KEY=

# Optional — AI evaluation through the Lovable AI gateway. Present automatically
# when the project is connected to Lovable Cloud. Used when GEMINI_API_KEY is
# unset. If neither key is set, falls back to RuleBasedEvaluator.
LOVABLE_API_KEY=
